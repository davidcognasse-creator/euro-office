# Copiez ce fichier en .env (ou configurez ces variables chez votre hébergeur)
# puis renseignez vos identifiants. NE COMMITTEZ JAMAIS votre vrai .env.

# Clé API Brevo (https://app.brevo.com → SMTP & API → API Keys)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Identifiant numérique de la liste d'abonnés (Brevo → Contacts → Listes)
BREVO_LIST_ID=2

# (Optionnel) Forcer le mois envoyé par la newsletter, format YYYY-MM.
# Laisser vide pour cibler automatiquement le mois précédent.
# NEWSLETTER_MONTH=2026-06
